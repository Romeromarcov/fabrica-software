# ═══════════════════════════════════════════════════════════════════════════
# Fábrica de Software — .env.example
# Copia a .env y rellena los valores reales.
# NUNCA commitear el .env real — ya está en .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# ── API Keys — Proveedores de IA ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...         # Requerido para A2,A3,A6,A7,A8
GOOGLE_API_KEY=AIza...               # Para A0,A1 (gemini-3.5-flash)
ZHIPU_API_KEY=...                    # Para A4 Backend (glm-5.1) — opcional
KIMI_API_KEY=sk-...                  # Para A5 Frontend (kimi-k2.6) — opcional

# ── Observabilidad (LangSmith) ────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false           # Cambiar a true para activar tracing
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=fabrica-software

# ── Modelos por agente ────────────────────────────────────────────────────────
MODEL_A0=gemini-3.5-flash            # A0 Arquitecto de Proyecto
MODEL_A1=gemini-3.5-flash            # A1 PM / Planificador
MODEL_A2=claude-sonnet-4-6           # A2 DB Architect
MODEL_A3=claude-sonnet-4-6           # A3 MCP Toolsmith
MODEL_A4=glm-5.1                     # A4 Backend Developer
MODEL_A5=kimi-k2.6                   # A5 Frontend Developer
MODEL_A6=claude-sonnet-4-6           # A6 Revisor / Refactor
MODEL_A7=claude-sonnet-4-6           # A7 QA Test
MODEL_A8=claude-sonnet-4-6           # A8 SecOps
# A9 Sandbox y A10 Code Writer no usan LLM (sin variable MODEL_A9/A10)
MODEL_A11=claude-sonnet-4-6          # A11 DevOps / Infrastructure
# V2 Fase 0 — último escalón de la cascada de modelo (agente→pipeline→global). Opcional.
GLOBAL_DEFAULT_MODEL=claude-sonnet-4-6

# ── Comportamiento del pipeline ────────────────────────────────────────────────
WRITE_TO_REPO=true                   # false = dry-run (loguea sin escribir archivos al repo)

# ── Telegram — Notificaciones + Bot interactivo ───────────────────────────────
TELEGRAM_BOT_TOKEN=                  # BotFather → /newbot
TELEGRAM_CHAT_ID=                    # api.telegram.org/bot<TOKEN>/getUpdates

# ── GitHub — PRs automáticos y OAuth ──────────────────────────────────────────
GITHUB_TOKEN=ghp_...                 # PAT con scopes: repo + workflow (fallback si no hay OAuth)
GITHUB_ACTOR=tu-usuario-github       # Usuario/org para autenticar git push
GIT_USER_NAME=Fábrica Bot            # Identidad git para commits de agentes
GIT_USER_EMAIL=bot@tudominio.com

# ── GitHub OAuth 2.0 (P0-B) — reemplaza el PAT manual ───────────────────────
# Crear en: github.com → Settings → Developer Settings → OAuth Apps → New OAuth App
# Authorization callback URL: http://localhost:7860/auth/callback
GITHUB_CLIENT_ID=                    # Ej: Ov23liABCDEFGHIJKLMN
GITHUB_CLIENT_SECRET=                # Ej: abc123...
GITHUB_OAUTH_SECRET=cambia-esto-por-una-clave-aleatoria-larga  # Firma de sesión
# GITHUB_OAUTH_CALLBACK_URL=http://localhost:7860/auth/callback  # override en producción

# ── Seguridad UI — Basic Auth (dejar vacío para desactivar) ──────────────────
UI_USERNAME=                         # Ej: admin
UI_PASSWORD=                         # Ej: password-seguro-aqui

# ── Rutas (sobreescritas por docker-compose en producción) ───────────────────
WORKSPACES_ROOT=/workspace           # En VPS: /opt/workspaces
RUNS_DIR=/data/runs
DB_PATH=/data/fabrica_state.db

# ── Límites del pipeline ──────────────────────────────────────────────────────
MAX_QA_ITER_COMPLETO=3
MAX_QA_ITER_LITE=2
MAX_SECOPS_ITER=2
MAX_SANDBOX_ITER=2
CHECKPOINT_TIMEOUT_SECONDS=1800
ARCH_REVIEW_INTERVAL=3               # Cada cuántos features corre el A0 Revisor (0=desactivado)

# ── Agente de Noticias ────────────────────────────────────────────────────────
NEWS_AGENT_ENABLED=true
NEWS_AGENT_HOUR=8
NEWS_AGENT_MODEL=claude-haiku-4-5-20251001

# ── VII-1: Chat pre-planificación ────────────────────────────────────────────
PRECHAT_ENABLED=true                 # false = deshabilita el chat y lanza directo

# ── VII-3: Railway Deploy ─────────────────────────────────────────────────────
# Crear token en: railway.com → Account Settings → Tokens
RAILWAY_TOKEN=                       # railway_xxxxxxxx
RAILWAY_PROJECT_ID=                  # UUID del proyecto (URL de railway.com)

# ── Bloque VIII (PLAN_MEJORAS) ────────────────────────────────────────────────
# VIII-3 — Debate inter-agente para features de riesgo ALTO (panel de 2 revisores
# + árbitro A1 antes de aprobar). Opt-in: añade ~3 llamadas LLM extra por plan HIGH.
DEBATE_PANEL_ENABLED=false           # true = activa el debate en risk_level=HIGH
MODEL_DEBATE=                        # vacío = usa MODEL_FAST (Haiku, económico)

# ── Auditor Periódico de Codebase ─────────────────────────────────────────────
AUDITOR_ENABLED=true
AUDITOR_WEEKDAY=0                    # 0=lunes … 6=domingo
AUDITOR_HOUR=7
AUDITOR_MAX_FILES=30
AUDITOR_MODEL=claude-sonnet-4-6
AUDITOR_REPO=all                     # "all" o nombre exacto del repo

# ── IX-1: Multi-usuario RBAC ─────────────────────────────────────────────────
# Si RBAC_ENABLED=true, TODAS las rutas requieren login con usuario/password.
# El primer arranque migra el usuario de BasicAuth (UI_USERNAME/UI_PASSWORD) como owner.
# Los nuevos usuarios se invitan desde /admin/users (solo owners).
RBAC_ENABLED=false

# ── IX-2: PWA Push Notifications (opcional) ──────────────────────────────────
# Para notificaciones push reales en el navegador, genera claves VAPID:
#   pip install py-vapid
#   vapid --gen    (genera private_key.pem y public_key.pem)
#   vapid --applicationServerKey   (genera la clave pública en formato URL-safe)
# Déjalos vacíos para deshabilitar push (PWA funciona igual, sin notificaciones).
VAPID_PUBLIC_KEY=                    # Clave pública URL-safe base64
VAPID_PRIVATE_KEY=                   # Clave privada PEM (una línea, sin headers)
VAPID_SUBJECT=mailto:admin@tudominio.com

# ── Bloque III: Intervención humana reducida ──────────────────────────────────
# Ventana de veto (minutos) antes de que el pipeline continúe automáticamente
VETO_WINDOW_MINUTES=30
# Auto-merge: fusiona el PR automáticamente si risk_level=LOW (requiere gh CLI)
AUTO_MERGE_ENABLED=false

# ── Bloque C (PLAN_BLINDAJE_TOTAL): condición de auto-merge ampliada ──────────
# C3: exige que el revisor independiente (GitHub Action fuera del pipeline) esté
# verde antes del auto-merge. Si no hay confirmación, el auto-merge se deniega.
INDEPENDENT_REVIEW_REQUIRED=true

# ── Bloque VI: Paralelismo de features ───────────────────────────────────────
# Habilita la ejecución paralela de features independientes en el Project Loop
PARALLEL_FEATURES_ENABLED=false
MAX_PARALLEL_FEATURES=2

# ── PLAN_BLINDAJE_TOTAL — Bloque A: hardening de seguridad de la fábrica ──────
# A1.1 — IDs de usuario de Telegram (no chat_id) autorizados a controlar el bot.
# Lista separada por comas. Vacío = solo se valida chat_id (compatibilidad; se loguea
# advertencia). RECOMENDADO en producción para evitar control por terceros en el chat.
TELEGRAM_ADMIN_IDS=
# A1.2 — Si no hay RBAC ni Basic Auth, la UI NO arranca (fallo seguro). Pon true SOLO
# en desarrollo local consciente: dejaría la UI abierta a quien tenga acceso de red.
UI_ALLOW_NO_AUTH=false
# A2.2 — Scanner determinista de secretos como gate duro en A9 (no depende del LLM).
SECRET_SCAN_GATE=true
# R4 — Validador de input (AIDefence lite) antes de A0: inyección de prompt → bloqueo,
# PII/secretos → sanitización (o bloqueo si STRICT).
INPUT_VALIDATION_GATE=true
INPUT_VALIDATION_STRICT=false
# M4 — Diff inteligente en A6: avisa si A6 reescribe > umbral del código (sobre-refactor).
INTELLIGENT_DIFF_GATE=false
INTELLIGENT_DIFF_THRESHOLD=0.85
# M3 — LLM-as-judge: evaluador ligero puntúa la salida de cada agente (opt-in).
LLM_JUDGE_ENABLED=false
LLM_JUDGE_MODEL=claude-haiku-4-5-20251001
LLM_JUDGE_MIN_SCORE=60
# M5 — Caché local de prompts (proveedores sin caché nativa; Anthropic ya cachea).
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_TTL_SECONDS=86400
# M8 — Contexto dinámico en A0: archivos relevantes a la tarea por keywords.
DYNAMIC_CONTEXT_ENABLED=false
# R1 / F0.2 — Memoria vectorial semántica (chromadb + sentence-transformers en requirements).
# ON por defecto; si faltan las deps degrada automáticamente a fallback por keywords.
VECTOR_MEMORY_ENABLED=true
# R3 — Paralelismo intra-feature A4+A5 (no confundir con PARALLEL_FEATURES_ENABLED).
PARALLEL_AGENTS_ENABLED=false
# Fase 5 — Agent Builder: registrar agentes generados conversacionalmente (doble gate: flag + aprobación).
AGENT_BUILDER_ENABLED=false
# Fase 6 — Pipeline Builder (doble gate: flag + aprobación).
PIPELINE_BUILDER_ENABLED=false
# Marketing — publicación real (push al canal). Default false = dry-run (decide sin publicar).
MARKETING_PUBLISH_ENABLED=false
# Fase 7 — Factory Modifier: auto-modificación de la fábrica (prompts/registry). Doble gate +
# deny-list dura + ruteo por PR (nunca main). Ítem de mayor riesgo (autofagia): default off.
FACTORY_MODIFIER_ENABLED=false
# M6 — A/B testing de modelos por agente (usa model_fallbacks del registry en AB_TESTING_PCT).
AB_TESTING_ENABLED=false
AB_TESTING_PCT=0.2
# M7 / F0.1 — Observabilidad OpenTelemetry (spans por agente). opentelemetry va en
# requirements. ON por defecto; define el endpoint OTLP para exportar a Jaeger (ver
# docker-compose.observability.yml: Jaeger UI en http://localhost:16686).
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# F0.1 — Traza del grafo en LangSmith (opcional, complementa OTel). Requiere API key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fabrica-software
# A2.3 — Allowlist de orígenes CORS (separados por comas). Vacío = sin CORS cruzado.
CORS_ALLOWED_ORIGINS=
# A3.4 — Los features importados (.md de sesiones) requieren aprobación explícita
# del Founder antes de que A0 los procese (mitiga prompt injection vía archivo subido).
IMPORTED_SESSION_REQUIRES_APPROVAL=true

# ── Bloque B (blindaje) — calidad de tests + cobertura de código nuevo ────────
# B2.3 — Gate DURO de calidad de tests: AST-parsea los tests generados y FALLA si
# alguno no tiene asserts, solo asserts triviales (assert True/1/"...") o está vacío.
TEST_QUALITY_GATE=true
# B2.2 — Gate de cobertura sobre las líneas de código NUEVO. Default false: si el repo
# no tiene datos de cobertura disponibles el gate hace SKIP (n/a), nunca asume verde.
NEW_CODE_COVERAGE_GATE=false
# B2.2 — % mínimo de cobertura exigido por archivo nuevo cuando NEW_CODE_COVERAGE_GATE=true.
COVERAGE_MIN_NEW=80

# ── Bloque D (PLAN_BLINDAJE_TOTAL) — entornos efímeros por feature ────────────
# D1.1 — Levanta un entorno docker-compose aislado por feature (app + postgres +
# redis opcional) con teardown garantizado. Pesado: déjalo en false salvo que el
# host tenga daemon docker y recursos para ello.
EPHEMERAL_ENV_ENABLED=false
# D1.3 — Límites de recursos por servicio del entorno efímero (memoria y CPUs).
EPHEMERAL_MEM_LIMIT=1g
EPHEMERAL_CPUS=1.0
# Timeout (s) del `compose up --wait`; ante timeout se hace teardown y se reporta fallo.
EPHEMERAL_TIMEOUT_SECONDS=300
# Antigüedad máxima (s) antes de que el reaper coseche un entorno huérfano fab-eph-*.
EPHEMERAL_MAX_AGE_SECONDS=3600

# ── PLAN_BLINDAJE_TOTAL — Bloque E: resiliencia LLM (E2) ──────────────────────
# E2.1 — Backoff exponencial + manejo de 429. Reintentos máximos y delay base (s).
# El backoff crece base*2**intento (topado y con jitter); ante 429 respeta Retry-After.
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SECONDS=2
# E2.2 — Circuit breaker: fallos consecutivos del proveedor antes de ABRIR el breaker
# (fallo rápido + aviso Telegram) en vez de dejar caer 100 features en cascada.
LLM_BREAKER_THRESHOLD=5
# E2.2 — Fallback de modelo: JSON opcional primario→alterno. Vacío = sin fallback.
# Ejemplo: MODEL_FALLBACKS={"glm-5.1":"claude-sonnet-4-6"}
MODEL_FALLBACKS=

# ── PLAN_BLINDAJE_TOTAL — Bloque D2.2: errores de runtime en dev ───────────────
# Recurrencias de un error de nivel `error` en dev que lo escalan a tier HIGH.
RUNTIME_ERROR_HIGH_THRESHOLD=10

# ── PLAN_BLINDAJE_TOTAL — Bloque D3.2: promoción a producción ──────────────────
# Deploy a prod SOLO desde esta rama (invariante: nunca desde un feature/branch).
PROD_DEPLOY_BRANCH=main
# Prefijo de los tags de release por promoción → `{prefix}-YYYYMMDD-NN`.
# Rollback inmediato = redeploy del tag de release anterior.
RELEASE_TAG_PREFIX=release

# ── PLAN_BLINDAJE_TOTAL — Bloque E: evals deterministas del pipeline ──────────
# E4 — Suite OFFLINE (sin LLM ni red) que valida que los gates deterministas atrapan
# problemas sembrados (secretos, fuga multi-tenant, tests triviales, clasificación de
# riesgo). Si true, el orquestador puede auto-correr la suite (tools/evals.run_evals);
# si false, no se auto-corre. Las funciones de tools/evals.py siempre funcionan a mano.
EVALS_ENABLED=true
