# Copia este archivo a .env y rellena los valores reales
# NUNCA commitear el .env — ya está en .gitignore

# Anthropic API Key (requerido)
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith (opcional pero recomendado para observabilidad y costos reales)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=omni-erp-fabrica

# Ruta al repo (si no corres cli.py desde la raíz del repo)
# En Docker este valor se sobreescribe automáticamente a /repo
OMNI_REPO_ROOT=C:/Users/PC/Proyectos/omni-erp

# ── Docker (solo necesario al correr con docker compose) ─────────────────────

# Token de GitHub para que `gh pr create` funcione dentro del contenedor
# Generar en: https://github.com/settings/tokens  (scopes: repo, workflow)
GH_TOKEN=ghp_...

# Identidad git para commits generados por los agentes
GIT_USER_NAME=Marco Romero
GIT_USER_EMAIL=tu@email.com
