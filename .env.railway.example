# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables para desplegar la FÁBRICA en Railway.
# Copia estos valores en Railway → tu servicio → Variables. NO commitees el real.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claves de IA (modo directo — recomendado en la nube) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
ZHIPU_API_KEY=...
KIMI_API_KEY=...

# ── OpenClaw: DESACTIVADO por defecto (modo directo) ─────────────────────────
# Para re-habilitar: build con --build-arg INSTALL_OPENCLAW=true, correr el
# servicio openclaw (compose --profile openclaw) y poner USE_OPENCLAW=true.
USE_OPENCLAW=false

# ── GitHub: token con acceso SOLO a omni-erp (contents:write, pull_requests:write)
GITHUB_TOKEN=github_pat_...
GITHUB_ACTOR=tu-usuario-github

# ── Clone-on-startup: repos destino (se clonan en /workspace al arrancar) ────
# Formato: [nombre=]url[#rama], separados por coma.
TARGET_REPOS=omni-erp=https://github.com/Romeromarcov/omni-erp.git#main

# ── Rutas (montadas sobre el volumen persistente de Railway en /data) ────────
WORKSPACES_ROOT=/workspace
RUNS_DIR=/data/runs
DB_PATH=/data/fabrica_state.db
TZ=America/Caracas

# ── Gates de garantía (Fases 1–3 del hardening) ─────────────────────────────
STRICT_GATES=true
TENANT_ISOLATION_GATE=auto
ADVERSARIAL_REVIEW_ENABLED=true
ADVERSARIAL_MIN_TIER=MEDIUM

# ── Autonomía (arranque conservador — ver RUNBOOK §7.4) ──────────────────────
AUTO_MERGE_ENABLED=false
PARALLEL_FEATURES_ENABLED=false
VETO_WINDOW_MINUTES=30

# ── Bloque C (PLAN_BLINDAJE_TOTAL): condición de auto-merge ampliada ──────────
# C3: exige que el revisor independiente (GitHub Action fuera del pipeline) esté
# verde antes del auto-merge. Si no hay confirmación, el auto-merge se deniega.
INDEPENDENT_REVIEW_REQUIRED=true

# ── Telegram (vetos / escalaciones) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
# A1.1 — IDs de usuario (no chat_id) autorizados a controlar el bot (coma-separados).
# RECOMENDADO en prod: sin esto, cualquiera en el chat con el chat_id puede operar.
TELEGRAM_ADMIN_IDS=

# ── Bloque A (blindaje) — endurecimiento de seguridad de la fábrica ──────────
# A1.2 — En la nube SIEMPRE configura auth: RBAC_ENABLED=true o UI_USERNAME/UI_PASSWORD.
# Dejar UI_ALLOW_NO_AUTH=false hace que la UI rechace arrancar sin auth (fallo seguro).
UI_ALLOW_NO_AUTH=false
# A2.2 — Scanner de secretos como gate duro en A9.
SECRET_SCAN_GATE=true
# R4 — Validador de input antes de A0 (inyección/PII/secretos).
INPUT_VALIDATION_GATE=true
INPUT_VALIDATION_STRICT=false
# A2.3 — Allowlist de orígenes CORS (ej: https://tu-ui.example.com). Vacío = sin CORS.
CORS_ALLOWED_ORIGINS=
# A3.4 — Features importados requieren aprobación explícita del Founder.
IMPORTED_SESSION_REQUIRES_APPROVAL=true

# ── Bloque B (blindaje) — calidad de tests + cobertura de código nuevo ────────
# B2.3 — Gate DURO de calidad de tests: FALLA si un test generado no tiene asserts,
# solo asserts triviales (assert True/1/"...") o está vacío.
TEST_QUALITY_GATE=true
# B2.2 — Gate de cobertura sobre líneas de código nuevo. Default false: sin datos de
# cobertura disponibles, el gate hace SKIP (n/a) en lugar de asumir verde.
NEW_CODE_COVERAGE_GATE=false
# B2.2 — % mínimo de cobertura por archivo nuevo (solo si NEW_CODE_COVERAGE_GATE=true).
COVERAGE_MIN_NEW=80

# ── Bloque D (PLAN_BLINDAJE_TOTAL) — entornos efímeros por feature ────────────
# D1.1 — Entorno docker-compose aislado por feature (app + postgres + redis opcional)
# con teardown garantizado. Pesado y requiere daemon docker: déjalo en false en Railway.
EPHEMERAL_ENV_ENABLED=false
# D1.3 — Límites de recursos por servicio del entorno efímero (memoria y CPUs).
EPHEMERAL_MEM_LIMIT=1g
EPHEMERAL_CPUS=1.0
# Timeout (s) del `compose up --wait`; ante timeout se hace teardown y se reporta fallo.
EPHEMERAL_TIMEOUT_SECONDS=300
# Antigüedad máxima (s) antes de que el reaper coseche un entorno huérfano fab-eph-*.
EPHEMERAL_MAX_AGE_SECONDS=3600

# ── PLAN_BLINDAJE_TOTAL — Bloque E: resiliencia LLM (E2) ──────────────────────
# E2.1 — Backoff exponencial + manejo de 429 (base*2**intento, topado, con jitter).
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_SECONDS=2
# E2.2 — Circuit breaker: fallos consecutivos antes de ABRIR (fallo rápido + aviso).
LLM_BREAKER_THRESHOLD=5
# E2.2 — Fallback de modelo: JSON opcional primario→alterno. Vacío = sin fallback.
# Ejemplo: MODEL_FALLBACKS={"glm-5.1":"claude-sonnet-4-6"}
MODEL_FALLBACKS=

# ── PLAN_BLINDAJE_TOTAL — Bloque E: evals deterministas del pipeline ──────────
# E4 — Suite OFFLINE (sin LLM ni red) que valida que los gates deterministas atrapan
# problemas sembrados (secretos, fuga multi-tenant, tests triviales, riesgo). Si true,
# el orquestador puede auto-correr la suite; las funciones siempre funcionan a mano.
EVALS_ENABLED=true

# ── V2 Fase 0 (PLAN_PLATAFORMA_V2) ────────────────────────────────────────────
# Último escalón de la cascada de modelo por agente (agente→pipeline→global). Opcional.
# GLOBAL_DEFAULT_MODEL=claude-sonnet-4-6

# ── Bloque VIII (PLAN_MEJORAS) ────────────────────────────────────────────────
# VIII-3 — Debate inter-agente para features de riesgo ALTO (panel de 2 revisores
# + árbitro A1 antes de aprobar). Opt-in: añade ~3 llamadas LLM extra por plan HIGH.
# DEBATE_PANEL_ENABLED=false   # true = activa el debate en risk_level=HIGH
# MODEL_DEBATE=                # vacío = usa MODEL_FAST (Haiku, económico)

# ── Railway API (OPCIONAL: para que la fábrica dispare/observe deploys de OmniERP)
# RAILWAY_TOKEN=...
# RAILWAY_PROJECT_ID=...   # el del proyecto OmniERP, no el de la fábrica

# ── Modelos por agente (opcional — tienen defaults sensatos en config.py) ────
# MODEL_A4=glm-5.1
# MODEL_A5=kimi-k2.6
